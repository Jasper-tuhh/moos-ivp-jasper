//--------    FILE: alpha.bhv   -------------

initialize   DEPLOY = false
initialize   RETURN = false
initialize   LOITER_REGION = west
initialize   WAITING = false

//----------------------------------------------
Behavior = BHV_Timer
 {   
   // General Behavior Parameters
   // ---------------------------
   name         = bhv_stoptime            // default
   condition    = RETURN = false
   condition    = DEPLOY = true
   condition    = WAITING = false
   duration     = 200                  // example
   perpetual    = true
   duration_reset = WAITING = false
   endflag      = WAITING = true       // example
   updates      = TIMER_UPDATES        // example

 }
 //----------------------------------------------
Behavior = BHV_Timer
 {   
   // General Behavior Parameters
   // ---------------------------
   name         = bhv_movetime            // default
   condition    = RETURN = false
   condition    = DEPLOY = true
   condition    = WAITING = true
   duration     = 60                  // example
   perpetual    = true
   duration_reset = WAITING = true
   endflag      = WAITING = false       // example
   updates      = TIMER_UPDATES        // example

 }
 //----------------------------------------------
Behavior = BHV_Loiter
 {
   // General Behavior Parameters
   // ---------------------------
   name         = transit_west
   pwt          = 100                   // default
   updates      = LOITER_UPDATES        // example
   condition	= LOITER_REGION  =  west
   condition = RETURN = false
   condition = DEPLOY = true
   condition = WAITING = false
   
   perpetual = true

   endflag   = LOITER_REGION = east
   endflag   = RETURN = false
   endflag   = DEPLOY = true

   // Parameters specific to this behavior
   // ------------------------------------
        acquire_dist = 10               // default
      capture_radius = 3                // default  
     center_activate = false            // default
           clockwise = false             // default
         slip_radius = 15               // default
               speed = 2.5                // default
       spiral_factor = -2               // default

        polygon = radial:: x=100,y=-75,radius=30,pts=8  // example
        
        visual_hints = vertex_size  = 1             // default
        visual_hints = edge_size    = 1             // default
        visual_hints = vertex_color = dodger_blue   // default
        visual_hints = edge_color   = white         // default
        visual_hints = nextpt_color = yellow        // default
        visual_hints = nextpt_lcolor = aqua         // default
        visual_hints = nextpt_vertex_size = 5       // default
        visual_hints = label        = zone3         // example
        
        duration = 150
        duration_idle_decay = false
 }

//----------------------------------------------
Behavior = BHV_Loiter
 {
   // General Behavior Parameters
   // ---------------------------
   name         = transit_east               // example
   pwt          = 100                   // default
   updates      = LOITER_UPDATES        // example
   condition	= LOITER_REGION  =  east
   condition = RETURN = false
   condition = DEPLOY = true
   condition = WAITING = false
   
   perpetual = true

   endflag   = LOITER_REGION = west
   endflag   = RETURN = false
   endflag   = DEPLOY = true

   // Parameters specific to this behavior
   // ------------------------------------
        acquire_dist = 10               // default
      capture_radius = 3                // default  
     center_activate = false            // default
           clockwise = true             // default
         slip_radius = 15               // default
               speed = 2.5                // default
       spiral_factor = -2               // default

        polygon = radial:: x=160,y=-50,radius=20,pts=8  // example
        
        visual_hints = vertex_size  = 1             // default
        visual_hints = edge_size    = 1             // default
        visual_hints = vertex_color = dodger_blue   // default
        visual_hints = edge_color   = white         // default
        visual_hints = nextpt_color = yellow        // default
        visual_hints = nextpt_lcolor = aqua         // default
        visual_hints = nextpt_vertex_size = 5       // default
        visual_hints = label        = zone3         // example
        
        duration = 150
        duration_idle_decay = false
 }

//----------------------------------------------
Behavior=BHV_Waypoint
{
  name      = waypt_return
  pwt       = 100
  condition = RETURN = true
  condition = DEPLOY = true
  perpetual = true
  updates   = RETURN_UPDATE
  endflag   = RETURN = false
  endflag   = DEPLOY = false
  endflag   = MISSION = complete
	
           speed = 2.0
  capture_radius = 2.0
     slip_radius = 8.0
          points = 0,0
 }

//----------------------------------------------
Behavior = BHV_ConstantDepth
 {
   // General Behavior Parameters
   // ---------------------------
   name         = const_dep_west   // example
   pwt          = 100                // default
   updates      = CONST_DEP_UPDATES  // example
   condition	= LOITER_REGION  =  west
   condition = WAITING = false

   // Parameters specific to this behavior
   // ------------------------------------
            basewidth = 100          // default
                depth = 30            // default
   depth_mismatch_var = DEPTH_DIFF   // example
             duration = 150            // default
             perpetual = true
             
            peakwidth = 3            // default
          summitdelta = 50           // default
 }
//----------------------------------------------
Behavior = BHV_ConstantDepth
 {
   // General Behavior Parameters
   // ---------------------------
   name         = const_dep_east   // example
   pwt          = 100                // default
   updates      = CONST_DEP_UPDATES  // example
   condition	= LOITER_REGION  =  east
   condition = WAITING = false

   // Parameters specific to this behavior
   // ------------------------------------
            basewidth = 100          // default
                depth = 10            // default
   depth_mismatch_var = DEPTH_DIFF   // example
             duration = 150            // 
             perpetual = true
            peakwidth = 3            // default
          summitdelta = 50           // default
 }
 //----------------------------------------
 Behavior = BHV_ConstantSpeed
 {
   // General Behavior Parameters
   // ---------------------------
   name         = transit_waiting
   pwt          = 100                   // default
   condition = RETURN = false
   condition = DEPLOY = true
   condition = WAITING = true
   
   perpetual = true
   speed = 0.0                
        
 }
  //----------------------------------------
 Behavior = BHV_ConstantDepth
 {
   // General Behavior Parameters
   // ---------------------------
   name         = const_dep_surface   // example
   pwt          = 100                // default
   updates      = CONST_DEP_UPDATES  // example
   condition    = WAITING = true
   
   // Parameters specific to this behavior
   // ------------------------------------
            basewidth = 100          // default
                depth = 0            // default
   depth_mismatch_var = DEPTH_DIFF   // example
             duration = no-time-limit             
             perpetual = true
            peakwidth = 3            // default
          summitdelta = 50           // default
 }



