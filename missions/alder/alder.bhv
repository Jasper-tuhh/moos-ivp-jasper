//--------    FILE: alder.bhv   -------------

initialize   DEPLOY = false
initialize   RETURN = false

//----------------------------------------------
Behavior = BHV_SimpleWaypoint
{ 
  name      = waypt_to_point
  pwt       = 100
  condition = RETURN = false
  condition = DEPLOY = true
  
  condition = (ODOMETRY_DIST < 50)  // line edited is true for distance smaller than 50
  
  endflag   = RETURN = true

  speed      = 12.0   // meters per second
  radius     = 8.0
  ptx        = 250
  pty        = 50
}

//----------------------------------------------
Behavior = BHV_Waypoint
{
  name       = waypt_return
  pwt        = 100
  
  condition = (RETURN = true) or (ODOMETRY_DIST >= 50) // line edited either is true for return button activated or distance is larger equal 50
  condition = DEPLOY = true // line edited is also true when deploy button is activated

  speed      = 18.5
  radius     = 8.0
  point      = 0,0
}

